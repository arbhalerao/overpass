# Absolute origin of the Overpass backend.
# Leave this UNSET for local development: the Vite dev server proxies /api and /ws to the backend for you (see vite.config.ts), so the browser sees one origin.
# Set it for a production build, where the static bundle is served from somewhere other than the API:

# VITE_API_BASE_URL=https://overpass-api.example.com
