# ---------------------------------------------------------------------------
# Overpass: root configuration, read by docker compose.
# Copy to .env and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Published host ports --------------------------------------------------
# Chosen to stay clear of the 3000 / 8080 / 9000 / 500xx / 520xx ranges already
# in use on this machine. Change them here and nowhere else.
FRONTEND_PORT=51800
BACKEND_PORT=51801

# --- Application -----------------------------------------------------------
APP_NAME=Overpass
APP_ENV=production
LOG_LEVEL=INFO
# json for production, console for humans
LOG_FORMAT=json

# --- OpenSky Network (aircraft) --------------------------------------------
# Optional. Without these the aircraft layer uses OpenSky's anonymous quota
# (400 credits/day); satellites are unaffected.
# Create an API client at https://opensky-network.org/my-opensky/api-clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- CelesTrak (satellites) ------------------------------------------------
# Comma-separated CelesTrak GROUP names. Keep this small: CelesTrak refreshes GP
# data every two hours and blocks clients that pull more often.
CELESTRAK_GROUPS=stations,visual

# Name searches, for satellites in no curated group. Each is a *substring* match, so
# CELESTRAK_NAMES=RISAT would also pull in MARISAT and TIGRISAT; use RISAT- to get
# just the four Indian radar-imaging satellites. Keep this short: one download each.
CELESTRAK_NAMES=
SATELLITE_CACHE_TTL_SECONDS=7200
AIRCRAFT_CACHE_TTL_SECONDS=5

# --- Skyfield --------------------------------------------------------------
# The ephemeris lives in the astronomy-data volume; leave downloads on for the
# first boot unless you have pre-seeded the volume yourself.
SKYFIELD_ALLOW_DOWNLOADS=true

# --- CORS ------------------------------------------------------------------
# Only needed for clients hitting the backend port directly; nginx serves the
# API on the frontend's own origin in the production stack.
CORS_ORIGINS=http://localhost:51800,http://127.0.0.1:51800,http://localhost:5173
