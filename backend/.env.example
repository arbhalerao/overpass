# Overpass - example environment configuration
# Copy to .env and adjust
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Overpass
APP_ENV=development
LOG_LEVEL=INFO
# json (structured, production) or console (human readable, development)
LOG_FORMAT=console

# --- HTTP server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS ------------------------------------------------------------------
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OpenSky Network (aircraft) --------------------------------------------
# Create an API client at https://opensky-network.org/my-opensky/api-clients
# OAuth2 client credentials are required.
# Leaving both blank falls back to anonymous access (heavily rate limited).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_TIMEOUT_SECONDS=15.0
# Allow unauthenticated requests when no credentials are configured.
OPENSKY_ALLOW_ANONYMOUS=true

# --- CelesTrak (satellite orbital elements) --------------------------------
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_TIMEOUT_SECONDS=30.0
# Comma separated CelesTrak GROUP names. Keep this small.
CELESTRAK_GROUPS=stations,visual
CELESTRAK_NAMES=

# --- Skyfield --------------------------------------------------------------
# Directory for the planetary ephemeris and cached orbital elements.
# The ephemeris is used only to place the Sun, which is what decides satellite visibility.
ASTRONOMY_DATA_DIR=./data
SKYFIELD_EPHEMERIS=de421.bsp
# Allow Skyfield to download the ephemeris on first start.
SKYFIELD_ALLOW_DOWNLOADS=true

# --- Caching ---------------------------------------------------------------
AIRCRAFT_CACHE_TTL_SECONDS=5
SATELLITE_CACHE_TTL_SECONDS=7200

# --- Observation area limits -----------------------------------------------
# The area is a circle of this radius around the chosen point.
RADIUS_MIN_KM=1.0
RADIUS_MAX_KM=250.0

# --- Visibility threshold (degrees above the horizon) ---------------------
MIN_SATELLITE_ELEVATION_DEG=10.0

# --- WebSocket refresh cadence (seconds) -----------------------------------
WS_AIRCRAFT_INTERVAL_SECONDS=10.0
WS_SATELLITE_INTERVAL_SECONDS=5.0
WS_MAX_MESSAGE_BYTES=8192
